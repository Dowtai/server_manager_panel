# Generate secrets: go run ./cmd/check
# Use a hex POSTGRES_PASSWORD so it is safe in a connection URI.
POSTGRES_PASSWORD=replace_with_64_random_hex_characters
ENCRYPTION_KEY=
SESSION_KEY=
SERVICE_TOKEN=
# ADMIN_PASSWORD='your password' go run ./cmd/check password
# Keep single quotes around bcrypt hashes in .env to prevent Compose $ interpolation.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''
PUBLIC_URL=http://localhost:8080
# Only for local development. Set false and use HTTPS for deployment.
INSECURE_COOKIE=true
AWG_RUNTIME_IMAGE=registry.example.org/awg-runtime@sha256:replace_with_built_image_digest
# Installer mode uses a local Docker image ID and mounts a docker-save archive.
AWG_RUNTIME_ARCHIVE=
TELEGRAM_BOT_TOKEN=
